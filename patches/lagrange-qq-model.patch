+                if (_onlineDeviceRefresh is not { IsCompleted: false })
+                    _onlineDeviceRefresh = RefreshOnlineDevicesAsync(_nextOnlineDevices.Task);
+                return _onlineDeviceRefresh.WaitAsync(cancellationToken);
