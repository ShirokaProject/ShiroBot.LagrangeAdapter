+                .WaitAsync(timeout.Token).ConfigureAwait(false);
+            if (result.Message != "register success")
+                throw new InvalidOperationException($"QQ online device refresh failed: {result.Message}");
+            return await next.WaitAsync(timeout.Token).ConfigureAwait(false);
+        }
+        catch (OperationCanceledException) when (timeout.IsCancellationRequested)
+        {
+            throw new TimeoutException("QQ did not return a fresh online device list.");
+        }
+    }
