+        if (target.CommonElem is not { ServiceType: 45, BusinessType: 1 or 3 } markdown)
+            return null;
+
+        var content = ProtoHelper.Deserialize<MarkdownPayload>(markdown.PbElem.Span).Content;
+        // QQ FlashTransfer pushes a Markdown card with business type 3.
+        return markdown.BusinessType == 1 || content.StartsWith("[闪传](mqqapi://markdown/node?", StringComparison.Ordinal)
+            ? new MarkdownEntity(content)
+            : null;
+    }
+
+    string IMessageEntity.ToPreviewString() => Content;
+}
+
+[ProtoPackable]
+internal partial class MarkdownPayload
+{
+    [ProtoMember(1)] public string Content { get; set; } = string.Empty;
+}
