+namespace Lagrange.Core.Exceptions;
+
+/// <summary>The server requires a web verification before a new SMS login attempt.</summary>
+public sealed class SmsLoginVerificationException(string message, string url) : Exception(message)
+{
+    public string Url { get; } = url;
+}
