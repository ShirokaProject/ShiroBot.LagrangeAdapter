diff --git a/Lagrange.Core/Internal/Logic/SmsLoginSession.cs b/Lagrange.Core/Internal/Logic/SmsLoginSession.cs
new file mode 100644
index 00000000..2ff4599d
--- /dev/null
+++ b/Lagrange.Core/Internal/Logic/SmsLoginSession.cs
@@ -0,0 +1,157 @@
+using System.Buffers.Binary;
+using System.Security.Cryptography;
+using System.Text;
+using Lagrange.Core.Exceptions;
+using Lagrange.Core.Internal.Events.Login;
+
+namespace Lagrange.Core.Internal.Logic;
+
+/// <summary>Transient proof for 810_11/13/12 and the subsequent 810_9 exchange.</summary>
+internal sealed class SmsLoginSession : IDisposable
+{
+    public long Uin { get; }
+    public byte[] PasswordHash { get; }
+    public byte[] Token { get; private set; } = [];
+    public byte[] Nonce { get; private set; } = [];
+    public ulong Salt { get; private set; }
+    public bool Verified { get; private set; }
+    public string? Url { get; private set; }
+    public string Phone { get; private set; } = "";
+    private bool _checked;
+    private bool _sent;
+
+    public SmsLoginSession(long uin)
+    {
+        if (uin is <= 0 or > uint.MaxValue) throw new ArgumentOutOfRangeException(nameof(uin));
+        Uin = uin;
+        // A fresh 16-character secret, never the QQ password. The server learns
+        // its salted hash only after the user supplies the SMS challenge proof.
+        var secret = RandomNumberGenerator.GetBytes(12);
+        try { PasswordHash = MD5.HashData(Encoding.ASCII.GetBytes(Convert.ToBase64String(secret))); }
+        finally { CryptographicOperations.ZeroMemory(secret); }
+    }
+
+    public void AccountChecked(LoginEventResp reply)
+    {
+        if (_checked || _sent) throw new InvalidOperationException("SMS login account check was already consumed.");
+        Require(reply, 208, "账号检查");
+        Update(reply);
+        if (Token.Length == 0 || Nonce.Length == 0 || !reply.Tlvs.ContainsKey(0x183))
+            throw new InvalidDataException("短信登录账号检查缺少会话 Token、随机挑战或 salt。");
+        _checked = true;
+    }
+
+    public void Sent(LoginEventResp reply)
+    {
+        if (!_checked || _sent) throw new InvalidOperationException("SMS login send is out of sequence.");
+        if (reply.RetCode is not (0 or 208)) Fail(reply, "发码");
+        Update(reply);
+        _sent = true;
+    }
+
+    public void Accept(LoginEventResp reply)
+    {
+        if (!_sent || Verified) throw new InvalidOperationException("SMS login verification is out of sequence.");
+        Require(reply, 0, "验证码验证");
+        Update(reply);
+        if (!reply.Tlvs.TryGetValue(0x113, out var account) || account.Length != 4 ||
+            BinaryPrimitives.ReadUInt32BigEndian(account) != Uin)
+            throw new InvalidDataException("短信登录返回的 QQ 账号与请求不一致。");
+        if (!reply.Tlvs.TryGetValue(0x104, out var proof) || proof.Length == 0)
+            throw new InvalidDataException("短信登录验证缺少换票据凭证。");
+        Verified = true;
+    }
+
+    public byte[] SaltedHash()
+    {
+        if (!_checked || !_sent) throw new InvalidOperationException("SMS proof requested before sending the challenge.");
+        Span<byte> input = stackalloc byte[24];
+        PasswordHash.CopyTo(input);
+        BinaryPrimitives.WriteUInt64BigEndian(input[16..], Salt);
+        return MD5.HashData(input);
+    }
+
+    private void Update(LoginEventResp reply)
+    {
+        if (reply.Tlvs.TryGetValue(0x104, out var token))
+        {
+            if (token.Length is 0 or > 4096) throw new InvalidDataException("短信会话 Token 长度无效。");
+            CryptographicOperations.ZeroMemory(Token);
+            Token = [.. token];
+        }
+        if (reply.Tlvs.TryGetValue(0x126, out var nonce))
+        {
+            if (nonce.Length < 4) throw new InvalidDataException("短信随机挑战无效。");
+            var length = BinaryPrimitives.ReadUInt16BigEndian(nonce.AsSpan(2));
+            if (length is 0 or > 4096 || length > nonce.Length - 4) throw new InvalidDataException("短信随机挑战长度无效。");
+            CryptographicOperations.ZeroMemory(Nonce);
+            Nonce = nonce.AsSpan(4, length).ToArray();
+        }
+        if (reply.Tlvs.TryGetValue(0x183, out var salt))
+        {
+            if (salt.Length != 8) throw new InvalidDataException("短信 salt 长度无效。");
+            Salt = BinaryPrimitives.ReadUInt64BigEndian(salt);
+        }
+        Url = ReadUrl(reply) ?? Url;
+        if (reply.Tlvs.TryGetValue(0x178, out var phone) && phone.Length >= 4)
+        {
+            var countryLength = BinaryPrimitives.ReadUInt16BigEndian(phone);
+            if (countryLength <= phone.Length - 4)
+            {
+                var position = 2 + countryLength;
+                var numberLength = BinaryPrimitives.ReadUInt16BigEndian(phone.AsSpan(position));
+                if (numberLength <= phone.Length - position - 2)
+                    Phone = Encoding.UTF8.GetString(phone, 2, countryLength) + "-" + Encoding.UTF8.GetString(phone, position + 2, numberLength);
+            }
+        }
+    }
+
+    private static void Require(LoginEventResp reply, int expected, string stage)
+    {
+        if (reply.RetCode != expected) Fail(reply, stage);
+    }
+
+    private static void Fail(LoginEventResp reply, string stage)
+    {
+        if (ReadUrl(reply) is { } url)
+            throw new SmsLoginVerificationException($"短信登录{stage}需要网页验证，完成后重新发起登录。", url);
+        throw new InvalidOperationException($"短信登录{stage}失败（code={reply.RetCode}）。");
+    }
+
+    private static string? ReadUrl(LoginEventResp reply)
+    {
+        foreach (ushort key in new ushort[] { 0x204, 0x192 })
+            if (reply.Tlvs.TryGetValue(key, out var value) && value.Length <= 8192 &&
+                Uri.TryCreate(Encoding.UTF8.GetString(value), UriKind.Absolute, out var uri) &&
+                uri.Scheme is "http" or "https" && uri.UserInfo.Length == 0) return uri.AbsoluteUri;
+        return null;
+    }
+
+    public void Dispose()
+    {
+        CryptographicOperations.ZeroMemory(PasswordHash);
+        CryptographicOperations.ZeroMemory(Token);
+        CryptographicOperations.ZeroMemory(Nonce);
+        Salt = 0;
+        Verified = false;
+    }
+}
+
+internal static class SmsLoginFlow
+{
+    public static async Task<LoginEventResp> Run(SmsLoginSession session,
+        Func<LoginEventReq, Task<LoginEventResp>> send, Func<string?, string, Task<string>> requestCode,
+        CancellationToken token)
+    {
+        token.ThrowIfCancellationRequested();
+        session.AccountChecked(await send(new(LoginEventReq.Command.SmsLoginAccount) { Sms = session }).WaitAsync(token));
+        token.ThrowIfCancellationRequested();
+        session.Sent(await send(new(LoginEventReq.Command.SmsLoginSend) { Sms = session }).WaitAsync(token));
+        var code = await requestCode(session.Url, session.Phone).WaitAsync(token);
+        if (code.Length is < 4 or > 8 || code.Any(c => !char.IsAsciiDigit(c))) throw new ArgumentException("短信验证码无效。");
+        token.ThrowIfCancellationRequested();
+        session.Accept(await send(new(LoginEventReq.Command.SmsLoginVerify) { Sms = session, Code = code }).WaitAsync(token));
+        token.ThrowIfCancellationRequested();
+        return await send(new(LoginEventReq.Command.Tgtgt) { Sms = session }).WaitAsync(token);
+    }
+}
