+namespace Lagrange.Core.Internal.Context;
+
+internal sealed class UploadLifetime
+{
+    private readonly object _gate = new();
+    private readonly CancellationTokenSource _stopping = new();
+    private readonly TaskCompletionSource _drained = new(TaskCreationOptions.RunContinuationsAsynchronously);
+    private int _active;
+    private Task? _stopTask;
+
+    public async Task<bool> RunAsync(Func<CancellationToken, Task<bool>> upload)
+    {
+        lock (_gate)
+        {
+            if (_stopTask is not null)
+                throw new OperationCanceledException("Media upload cancelled because the QQ session is closing.");
+            _active++;
+        }
+
+        try
+        {
+            return await upload(_stopping.Token).ConfigureAwait(false);
+        }
+        finally
+        {
+            lock (_gate)
+            {
+                if (--_active == 0 && _stopTask is not null)
+                    _drained.TrySetResult();
+            }
+        }
+    }
+
+    public Task StopAsync(Action dispose)
+    {
+        lock (_gate)
+            return _stopTask ??= StopCoreAsync(dispose);
+    }
+
+    private async Task StopCoreAsync(Action dispose)
+    {
+        if (_active == 0) _drained.TrySetResult();
+        try
+        {
+            await _stopping.CancelAsync().ConfigureAwait(false);
+        }
+        finally
+        {
+            await _drained.Task.ConfigureAwait(false);
+            _stopping.Dispose();
+            dispose();
+        }
+    }
+}
