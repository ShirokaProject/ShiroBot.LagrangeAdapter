+<template>
+  <section v-if="loaded && (pages.length || error)">
+    <p v-if="error" role="alert">{{ error }}</p>
+    <div v-if="pages.length > 1" class="button-group"><button v-for="page in pages" :key="page.id" class="md-button tonal" @click="selected = page.id">{{ page.title }}</button></div>
+    <WebPagePanel v-if="active" :key="id + active.id" :plugin-id="id" :definition="active" owner-kind="adapters" />
+  </section>
+</template>
+<script setup lang="ts">
+import { computed, ref, watch } from 'vue'
+import { apiRequest, getApiErrorMessage, type PluginPage } from '../../../api'
+import WebPagePanel from '../../pluginPages/WebPagePanel.vue'
+const props = defineProps<{ id: string; loaded: boolean }>()
+const pages = ref<PluginPage[]>([]), error = ref(''), selected = ref('')
+const active = computed(() => pages.value.find(x => x.id === selected.value) || pages.value[0])
+let generation = 0
+watch(() => [props.id, props.loaded], async () => {
+  const current = ++generation; pages.value = []; error.value = ''
+  if (!props.loaded) return
+  try {
+    const result = await apiRequest<{ pages: PluginPage[] }>(`/api/v1/adapters/${encodeURIComponent(props.id)}/pages`)
+    if (current === generation) pages.value = result.pages.filter(x => x.kind === 'web')
+  } catch (cause) { if (current === generation) error.value = getApiErrorMessage(cause, '适配器页面加载失败。') }
+}, { immediate: true })
+</script>
